# Скопируйте в .env и поменяйте при необходимости. Файл .env в git не попадает.

# Телефоны (через запятую), которые при первом входе становятся администраторами платформы.
BOOTSTRAP_ADMIN_PHONES=+79990000001

# Режим разработки: код из СМС показывается прямо на экране входа.
OTP_DEBUG=true

# Для боевого сервера (ENV=prod) обязательно:
# JWT_SECRET=случайная-строка-не-короче-32-символов
# COOKIE_SECURE=true
# OTP_DEBUG=false

# Адрес сайта: из него собирается ссылка входа для бригады в СМС.
# PUBLIC_BASE_URL=https://umny-remont.ru
# Хранилище фото на сервере: S3-совместимое (Yandex Object Storage, VK Cloud, Selectel).
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://storage.yandexcloud.net
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
