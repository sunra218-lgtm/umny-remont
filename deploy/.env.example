# Скопируйте в deploy/.env на сервере и заполните. Файл .env в git не попадает.
# Случайные строки: openssl rand -hex 32

DOMAIN=umny-remont.ru
ACME_EMAIL=admin@umny-remont.ru

POSTGRES_PASSWORD=
JWT_SECRET=
BANK_WEBHOOK_SECRET=

# Банк безопасной сделки. fake — имитация (пока нет договора), tbank — Т-Банк.
# Ключи и пароли терминалов банк выдаёт в личном кабинете; вписываются только сюда, на сервере.
# У тестовых терминалов ключ заканчивается на DEMO. Подробно — docs/tbank.md.
BANK_BACKEND=fake
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_PAYOUT_TERMINAL_KEY=
TBANK_PAYOUT_PASSWORD=
TBANK_PLATFORM_PARTNER_ID=

# Телефоны администраторов платформы (через запятую): при первом входе получают роль админа.
BOOTSTRAP_ADMIN_PHONES=+7XXXXXXXXXX

PLATFORM_INN=
PLATFORM_LEGAL_NAME=ООО «Умный ремонт»

# Фото — в Yandex Object Storage (приватный бакет, регион ru-central1).
# Без S3 можно временно хранить на диске сервера: STORAGE_BACKEND=local
STORAGE_BACKEND=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=umny-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Помощник мастера. search — ответы из техкарт без внешних сервисов.
# yandexgpt — YandexGPT в Яндекс Облаке (данные остаются в РФ): нужен каталог и API-ключ
# сервисного аккаунта с ролью ai.languageModels.user.
ASSISTANT_BACKEND=search
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# Камеры на объекте: сколько дней хранить кадры.
CAMERA_RETENTION_DAYS=90

# Умный дизайн-проект. По умолчанию всё работает без внешних сервисов: помещения
# заготавливаются по площади, комнаты рисуются схемой в цветах отделки.
# yandex_ocr — читать экспликацию с плана БТИ (Yandex Vision, роль ai.vision.user);
# yandexart — фотореалистичные картинки комнат (YandexART, роль ai.imageGeneration.user).
# Ключ и каталог — те же YANDEX_FOLDER_ID и YANDEX_API_KEY.
DESIGN_PLAN_READER=manual
DESIGN_RENDERER=preview
# Контент-завод роликов (отдельный проект). Пока пусто — кнопки ролика нет. См. docs/design.md.
CONTENT_FACTORY_URL=
CONTENT_FACTORY_KEY=

WEB_CONCURRENCY=2
