# HTTPS-сертификат Caddy получает и продлевает сам. API идёт напрямую в backend, страницы — в сайт.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Фото отчёта до 2 МБ, накладные и голосовые заявки до 10 МБ — с запасом.
	request_body {
		max_size 15MB
	}

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format json
	}
}
